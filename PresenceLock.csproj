<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>PresenceLock</AssemblyName>
    <RootNamespace>PresenceLock</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="presencelock.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The default SDK glob does not auto-exclude nested project directories that live under
    this one — without this, PresenceLock.Tests' xunit-only .cs files would be compiled
    straight into this WinExe (no xunit reference here), and would fail the build.
  -->
  <ItemGroup>
    <Compile Remove="PresenceLock.Tests\**\*.cs" />
  </ItemGroup>

  <!--
    Do not add an explicit FSharp.Core PackageReference here — it flows transitively from
    this ProjectReference (rfc-core-brain.md, slice 1).
  -->
  <ItemGroup>
    <ProjectReference Include="PresenceLock.Core\PresenceLock.Core.fsproj" />
  </ItemGroup>

</Project>
